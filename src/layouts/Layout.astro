<style>
	:global(:root) {
		--accent: #ffa987;
		--accent-2: #ffb7c5;
		--gradient: linear-gradient(135deg, var(--accent-2), var(--accent));
		--gradient-flow: linear-gradient(90deg, var(--accent-2), var(--accent), var(--accent-2));
	}

	html {
		margin: 0;
		width: 100%;
		scroll-padding-top: 90px;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}

	body {
		font-family: system-ui, sans-serif;
		background-color: #14161a;
		color: #f0f0f0;
		line-height: 1.6;
	}

	body {
		background-image: radial-gradient(ellipse at top, rgba(255, 183, 197, 0.12), transparent 55%);
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	h1, h2, h3 {
		font-family: inherit;
		line-height: 1.2;
	}

	:global(a:link),
	:global(a:visited) {
		color: var(--accent);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: #14161a;
	}

	.site-header::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--gradient-flow);
		background-size: 200% 100%;
		animation: flow 8s linear infinite;
	}

	.header-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding: 0.85rem 1.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
	}

	.brand-avatar {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: var(--gradient);
		color: #14161a;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.brand-name {
		font-weight: 700;
		font-size: 1.05rem;
		color: #f0f0f0;
	}

	.brand-role {
		font-size: 0.75rem;
		color: #999;
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}

	nav a {
		text-decoration: none;
		font-weight: 600;
	}

	nav a:hover {
		text-decoration: underline;
	}

	.header-links {
		display: flex;
		gap: 1.25rem;
	}

	.header-links a {
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--accent);
		border-radius: 6px;
	}

	.header-links a:hover {
		background: var(--gradient-flow);
		background-size: 200% 100%;
		animation: flow 2s linear infinite;
		color: #14161a;
	}
	
</style>

<style is:global>
	@keyframes flow {
		to {
			background-position: 200% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
		}
	}
</style>
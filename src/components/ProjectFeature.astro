---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const url = `/portfolio/projects/${project.id}`;
const dateLabel = project.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

// Same icons as the case-study page. Later we can move these to one shared place.
const icons = {
	genre: '<path d="M3 3h8.5L21 12.5 12.5 21 3 11.5z"/><circle cx="7.5" cy="7.5" r="1.3"/>',
	status: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>',
	date: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
	duration: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	role: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/>',
	engine: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
	tools: '<path d="M3 6h11M18 6h3M3 12h5M12 12h9M3 18h12M19 18h2"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
	iterations: '<path d="M4 12a8 8 0 0 1 13.66-5.66M17.5 2.5v4h-4M20 12a8 8 0 0 1-13.66 5.66M6.5 21.5v-4h4"/>',
	playtests: '<rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 10v5M4.5 12.5h5"/><circle cx="15.5" cy="11" r="1" fill="currentColor"/><circle cx="18" cy="14" r="1" fill="currentColor"/>',
};

// The list of facts shown beside the media. Reorder or delete lines to change it.
const infoItems = [
	{ icon: icons.genre, label: 'Genre', value: project.data.genre },
	{ icon: icons.status, label: 'Status', value: project.data.status },
	{ icon: icons.date, label: 'Date', value: dateLabel },
	{ icon: icons.duration, label: 'Duration', value: project.data.duration },
	{ icon: icons.role, label: 'Role', value: project.data.role },
	{ icon: icons.engine, label: 'Engine', value: project.data.engine },
	{ icon: icons.tools, label: 'Tools', value: project.data.tools.join(', ') },
].filter((item) => item.value);

const pills = [
	{ icon: icons.iterations, label: 'Iterations', value: project.data.iterations },
	{ icon: icons.playtests, label: 'Playtests', value: project.data.playtests },
].filter((pill) => pill.value !== undefined);
---
<article class="feature">
	<h2 class="feature-title">{project.data.title}</h2>
	{project.data.hook && <p class="feature-hook">{project.data.hook}</p>}

	<div class="feature-body">
		{project.data.heroVideo ? (
			<div class="feature-media feature-video">
				<iframe
					src={`https://www.youtube-nocookie.com/embed/${project.data.heroVideo}`}
					title={project.data.title}
					loading="lazy"
					allowfullscreen
				></iframe>
			</div>
		) : (
			<a class="feature-media" href={url} aria-label={`Open the ${project.data.title} case study`}>
				{project.data.coverImage
					? <img src={project.data.coverImage} alt="" style={`object-position: ${project.data.coverImagePosition ?? 'center'};`} />
					: <span class="placeholder">{project.data.title.charAt(0)}</span>}
			</a>
		)}

		<div class="feature-info">
			<ul class="info-list">
				{infoItems.map((item) => (
					<li>
						<svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
						<span class="info-text"><span class="label">{item.label}:</span> {item.value}</span>
					</li>
				))}
			</ul>

			{pills.length > 0 && (
				<div class="pills">
					{pills.map((pill) => (
						<span class="pill">
							<svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={pill.icon} />
							{pill.label}: {pill.value}
						</span>
					))}
				</div>
			)}

			<a class="view-btn" href={url}>View case study</a>
		</div>
	</div>
</article>

<style>
	.feature-title {
		width: fit-content;
		margin: 0 auto 0.4rem;
		display: flex;
		align-items: center;
		justify-content: center;		text-align: center;
		font-size: 2.2rem;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.feature-hook {
		max-width: 60ch;
		margin: 0 auto 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;		text-align: center;
		color: #bbb;
	}

	.feature-body {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 1.75rem;
		align-items: center;
	}

	.feature-body > * {
		min-width: 0;
	}

	/* Gradient frame: transparent border over a gradient painted under the border area */
	.feature-media {
		position: relative;
		display: block;
		box-sizing: border-box;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 3px solid transparent;
		border-radius: var(--radius);
		background: var(--gradient) border-box;
		overflow: hidden;
	}

	.feature-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.feature-video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: #14161a;
		font-family: var(--font-heading);
		font-size: 4rem;
		font-weight: 600;
		color: #444;
	}

	.info-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		line-height: 1.4;
		font-size: 1.05rem;
	}

	.info-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.info-icon {
		flex: 0 0 1.1rem;
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.2rem;
		color: var(--accent);
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.label {
		color: var(--accent);
		font-weight: 600;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.9rem 0.3rem 0.7rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		font-family: var(--font-heading);
		font-size: 0.95rem;
		color: var(--accent);
	}

	.pill .info-icon {
		margin-top: 0;
	}

	.view-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 1.25rem;
		padding: 0.6rem 1.3rem;
		border-radius: 999px;
		background: var(--gradient-flow);
		background-size: 200% 100%;
		color: #14161a;
		font-family: var(--font-heading);
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
	}

	.view-btn:hover {
		animation: flow 2s linear infinite;
	}

	.view-btn:focus-visible,
	.feature-media:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (max-width: 800px) {
		.feature-body {
			grid-template-columns: 1fr;
		}

		.feature-title {
			font-size: 1.8rem;
		}
	}
</style>

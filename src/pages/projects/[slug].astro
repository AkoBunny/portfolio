---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
---
<Layout>
	<a href="/portfolio/projects">← Back to Projects</a>

	<div class="project-main">
		<h1>{project.data.title}</h1>

		<div class="info-block">
			{project.data.genre && <p><strong>Genre:</strong> {project.data.genre}</p>}
			<p><strong>Tools:</strong> {project.data.tools.join(', ')}</p>
			{project.data.role && <p><strong>Role:</strong> {project.data.role}</p>}
			{project.data.studio && <p><strong>Studio:</strong> {project.data.studio}</p>}
			{project.data.teamSize && <p><strong>Team size:</strong> {project.data.teamSize}</p>}
			<p><strong>Status:</strong> {project.data.status}</p>
			<p><strong>Category:</strong> {project.data.category.join(', ')}</p>
			{project.data.playableLink && (
				<p><a class="playable-link" href={project.data.playableLink}>Play the build →</a></p>
			)}
		</div>

		<div class="case-study">
			<Content />
		</div>
	</div>

	{sections.length > 0 && (
		<details class="toc-float">
			<summary>Skip to...</summary>
			<ul>
				{sections.map((heading) => (
					<li><a href={`#${heading.slug}`}>{heading.text}</a></li>
				))}
			</ul>
		</details>
	)}
</Layout>

<style>
	.project-main {
		margin-top: 1.5rem;
	}

	.info-block {
		border: 1px solid #333;
		border-radius: 8px;
		padding: 1rem 1.25rem;
		margin: 1rem 0 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.playable-link {
		font-weight: 600;
	}

	:global(.case-study h2) {
		margin-top: 2.5rem;
	}

	:global(.video-embed) {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
		border-radius: 8px;
		overflow: hidden;
	}

	:global(.video-embed iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.toc-float {
		position: fixed;
		bottom: 1.5rem;
		left: 1.5rem;
		background: #1e2127;
		border: 1px solid #444;
		border-radius: 8px;
		padding: 0.6rem 1rem;
		max-width: 220px;
		z-index: 10;
	}

	.toc-float summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #999;
	}

	.toc-float ul {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		max-height: 40vh;
		overflow-y: auto;
	}
</style>
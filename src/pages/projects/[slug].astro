		display: block;
	}

	:global(.gallery-dots) {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
	}

	:global(.gallery-dot) {
		width: 12px;
		height: 12px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: #3a3f47;
		cursor: pointer;
	}

	:global(.gallery-dot.active) {
		background: #ff9d5c;
	}

</style>

<script>
	// Before / after sliders
	document.querySelectorAll<HTMLElement>('.compare').forEach((el) => {
		let pos = 50;

		const apply = (value: number) => {
			pos = Math.min(100, Math.max(0, value));
			el.style.setProperty('--pos', `${pos}%`);
			el.setAttribute('aria-valuenow', String(Math.round(pos)));
		};

		const fromPointer = (clientX: number) => {
			const rect = el.getBoundingClientRect();
			apply(((clientX - rect.left) / rect.width) * 100);
		};

		el.addEventListener('pointerdown', (e) => {
			el.setPointerCapture(e.pointerId);
			fromPointer(e.clientX);
		});

		el.addEventListener('pointermove', (e) => {
			if (el.hasPointerCapture(e.pointerId)) fromPointer(e.clientX);
		});

		el.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') apply(pos - 5);
			if (e.key === 'ArrowRight') apply(pos + 5);
		});

		apply(50);
	});

	// Gallery arrows and dots
	document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
		const slides = Array.from(gallery.querySelectorAll<HTMLElement>('img'));
		if (slides.length < 2) return;

		const wrap = document.createElement('div');
		wrap.className = 'gallery-wrap';
		gallery.before(wrap);
		wrap.appendChild(gallery);

		const slideCentre = (slide: HTMLElement) => {
			const g = gallery.getBoundingClientRect();
			const s = slide.getBoundingClientRect();
			return s.left - g.left + gallery.scrollLeft + s.width / 2;
		};

		const currentIndex = () => {
			const viewCentre = gallery.scrollLeft + gallery.clientWidth / 2;
			let best = 0;
			slides.forEach((slide, i) => {
				const distance = Math.abs(slideCentre(slide) - viewCentre);
				const bestDistance = Math.abs(slideCentre(slides[best]) - viewCentre);
				if (distance < bestDistance) best = i;
			});
			return best;
		};

		const goTo = (index: number) => {
			const i = Math.min(slides.length - 1, Math.max(0, index));
			gallery.scrollTo({
				left: slideCentre(slides[i]) - gallery.clientWidth / 2,
				behavior: 'smooth',
			});
		};

		const makeButton = (className: string, label: string, text: string) => {
			const b = document.createElement('button');
			b.type = 'button';
			b.className = className;
			b.setAttribute('aria-label', label);
			b.textContent = text;
			return b;
		};

		const prev = makeButton('gallery-btn gallery-prev', 'Previous image', '');
		const next = makeButton('gallery-btn gallery-next', 'Next image', '');
		const chevron = (d: string) =>
			`<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
		prev.innerHTML = chevron('M15 5l-7 7 7 7');
		next.innerHTML = chevron('M9 5l7 7-7 7');
		wrap.append(prev, next);

		const dots = document.createElement('div');
		dots.className = 'gallery-dots';
		const dotButtons = slides.map((_, i) => {
			const d = makeButton('gallery-dot', `Go to image ${i + 1}`, '');
			d.addEventListener('click', () => goTo(i));
			dots.appendChild(d);
			return d;
		});
		wrap.after(dots);

		const update = () => {
			const i = currentIndex();
			dotButtons.forEach((d, n) => d.classList.toggle('active', n === i));
			prev.disabled = i === 0;
			next.disabled = i === slides.length - 1;
		};

		prev.addEventListener('click', () => goTo(currentIndex() - 1));
		next.addEventListener('click', () => goTo(currentIndex() + 1));
		gallery.addEventListener('scroll', update, { passive: true });
		update();
	});
</script>

<style is:global>

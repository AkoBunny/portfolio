---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
const hasMedia = Boolean(project.data.heroVideo || project.data.coverImage);
const dateLabel = project.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Layout>
	<a href="/portfolio/projects">← Back to Projects</a>

	<div class="project-main">
		<h1>{project.data.title}</h1>

		<div class:list={['project-hero', { 'has-media': hasMedia }]}>
			{project.data.heroVideo ? (
				<div class="video-embed hero-media">
					<iframe
						src={`https://www.youtube-nocookie.com/embed/${project.data.heroVideo}`}
						title={project.data.title}
						allowfullscreen
					></iframe>
				</div>
			) : project.data.coverImage ? (
				<img class="hero-media hero-image" src={project.data.coverImage} alt="" />
			) : null}

			<div class="hero-info">
				<ul class="info-list">
					{project.data.genre && <li><span class="label">Genre:</span> {project.data.genre}</li>}
					<li><span class="label">Status:</span> {project.data.status}</li>
					<li><span class="label">Date:</span> {dateLabel}</li>
					{project.data.duration && <li><span class="label">Duration:</span> {project.data.duration}</li>}
					{project.data.teamSize && <li><span class="label">Team size:</span> {project.data.teamSize}</li>}
					{project.data.role && <li><span class="label">Role:</span> {project.data.role}</li>}
					{project.data.studio && <li><span class="label">Studio:</span> {project.data.studio}</li>}
					{project.data.engine && <li><span class="label">Engine:</span> {project.data.engine}</li>}
					{project.data.tools.length > 0 && <li><span class="label">Tools:</span> {project.data.tools.join(', ')}</li>}
					{project.data.assetsUsed && project.data.assetsUsed.length > 0 && (
						<li><span class="label">Assets used:</span> {project.data.assetsUsed.join(', ')}</li>
					)}
					{project.data.iterations !== undefined && <li><span class="label">Iterations:</span> {project.data.iterations}</li>}
					{project.data.playtests !== undefined && <li><span class="label">Playtests:</span> {project.data.playtests}</li>}
				</ul>
				{project.data.playableLink && (
					<a class="play-btn" href={project.data.playableLink}>Play the build</a>
				)}
			</div>
		</div>

		<div class="case-study">
			<Content />
		</div>
	</div>

	{sections.length > 0 && (
		<details class="toc-float">
			<summary>Skip to...</summary>
			<ul>
				{sections.map((heading) => (
					<li><a href={`#${heading.slug}`}>{heading.text}</a></li>
				))}
			</ul>
		</details>
	)}
</Layout>

<style>
	.project-main {
		margin-top: 1.5rem;
	}

	.project-main > h1 {
		text-align: center;
		color: #ff9d5c;
		font-size: 2.4rem;
		margin: 1rem 0 1.5rem;
	}

	.project-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.75rem;

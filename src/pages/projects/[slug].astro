		margin: 0;
		width: 100%;
		box-sizing: border-box;
		border: 1px solid #444;
		border-radius: 8px;
	}

	.hero-image {
		display: block;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.info-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		line-height: 1.4;
	}

	.label {
		color: #ff9d5c;
		font-weight: 600;
	}

	.play-btn {
		display: inline-block;
		margin-top: 1.1rem;
		padding: 0.55rem 1.1rem;
		border-radius: 6px;
		background: #ff9d5c;
		color: #14161a;
		font-weight: 600;
		text-decoration: none;
	}

	.toc-float {
		position: fixed;
		bottom: 1.5rem;
		left: 1.5rem;
		background: #1e2127;
		border: 1px solid #444;
		border-radius: 8px;
		padding: 0.6rem 1rem;
		max-width: 220px;
		z-index: 10;
	}

	.toc-float summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #999;
	}

	.toc-float ul {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;

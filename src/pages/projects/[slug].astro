</style>

<script>
	// ---- Image viewer (lightbox) ----
	const svg = (paths: string) =>
		`<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

	const ICONS = {
		close: svg('<path d="M6 6l12 12M18 6L6 18"/>'),
		zoomIn: svg('<circle cx="11" cy="11" r="6"/><path d="M21 21l-5-5M11 8v6M8 11h6"/>'),
		zoomOut: svg('<circle cx="11" cy="11" r="6"/><path d="M21 21l-5-5M8 11h6"/>'),
		fullscreen: svg('<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>'),
		exitFullscreen: svg('<path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/>'),
		share: svg('<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>'),
		prev: svg('<path d="M15 5l-7 7 7 7"/>'),
		next: svg('<path d="M9 5l7 7-7 7"/>'),
	};

	const root = document.createElement('div');
	root.className = 'lb';
	root.setAttribute('role', 'dialog');
	root.setAttribute('aria-modal', 'true');
	root.setAttribute('aria-label', 'Image viewer');
	root.innerHTML = `
		<div class="lb-backdrop"></div>
		<div class="lb-toolbar">
			<button type="button" class="lb-btn" data-act="zoom-out" aria-label="Zoom out" title="Zoom out">${ICONS.zoomOut}</button>
			<button type="button" class="lb-btn" data-act="zoom-in" aria-label="Zoom in" title="Zoom in">${ICONS.zoomIn}</button>
			<div class="lb-share">
				<button type="button" class="lb-btn" data-act="share" aria-label="Share" title="Share">${ICONS.share}</button>
				<div class="lb-menu" hidden>
					<a data-share="facebook" target="_blank" rel="noopener">Facebook</a>
					<a data-share="x" target="_blank" rel="noopener">X (Twitter)</a>
					<a data-share="pinterest" target="_blank" rel="noopener">Pinterest</a>
					<a data-share="download" download>Download image</a>
				</div>
			</div>
			<button type="button" class="lb-btn" data-act="fullscreen" aria-label="Fullscreen" title="Fullscreen">${ICONS.fullscreen}</button>
			<button type="button" class="lb-btn" data-act="close" aria-label="Close" title="Close">${ICONS.close}</button>
		</div>
		<button type="button" class="lb-nav lb-prev" aria-label="Previous image">${ICONS.prev}</button>
		<div class="lb-stage"><img class="lb-img" alt="" draggable="false"></div>
		<button type="button" class="lb-nav lb-next" aria-label="Next image">${ICONS.next}</button>
		<div class="lb-caption"></div>
	`;
	document.body.appendChild(root);

	const q = <T extends HTMLElement>(selector: string) => root.querySelector(selector) as T;
	const stage = q<HTMLElement>('.lb-stage');
	const img = q<HTMLImageElement>('.lb-img');
	const caption = q<HTMLElement>('.lb-caption');
	const prevBtn = q<HTMLButtonElement>('.lb-prev');
	const nextBtn = q<HTMLButtonElement>('.lb-next');
	const fsBtn = q<HTMLButtonElement>('[data-act="fullscreen"]');
	const menu = q<HTMLElement>('.lb-menu');

	const MAX_SCALE = 6;
	const STEP_PX = 120;

	let items: HTMLImageElement[] = [];
	let index = 0;
	let scale = 1;
	let tx = 0;
	let ty = 0;
	let baseW = 0;
	let baseH = 0;
	let lastTrigger: HTMLElement | null = null;

	// Size the image so it fits the stage (scale 1 = "fit to screen")
	function fitImage() {
		const nw = img.naturalWidth || 1;
		const nh = img.naturalHeight || 1;
		const f = Math.min(stage.clientWidth / nw, stage.clientHeight / nh);
		baseW = nw * f;
		baseH = nh * f;
		img.style.width = `${baseW}px`;
		img.style.height = `${baseH}px`;
	}

	// Apply pan and zoom, keeping the image from being dragged out of view
	function apply() {
		const maxX = Math.max(0, (baseW * scale - stage.clientWidth) / 2);
		const maxY = Math.max(0, (baseH * scale - stage.clientHeight) / 2);
		tx = Math.min(maxX, Math.max(-maxX, tx));
		ty = Math.min(maxY, Math.max(-maxY, ty));
		img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
		stage.classList.toggle('zoomed', scale > 1);
	}

	// Zoom towards a point (cx, cy measured from the stage centre) so the
	// spot under the cursor stays put while the image grows
	function zoomAt(cx: number, cy: number, factor: number) {
		const next = Math.min(MAX_SCALE, Math.max(1, scale * factor));
		const k = next / scale;
		tx = cx - (cx - tx) * k;
		ty = cy - (cy - ty) * k;
		scale = next;
		if (scale === 1) {
			tx = 0;
			ty = 0;
		}
		apply();
	}

	function show(i: number) {
		index = Math.min(items.length - 1, Math.max(0, i));
		const source = items[index];
		const label = source.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || source.alt;
		scale = 1;
		tx = 0;
		ty = 0;
		img.alt = source.alt;
		img.src = source.dataset.full || source.currentSrc || source.src;
		if (img.complete && img.naturalWidth) fitImage();
		apply();
		caption.textContent = items.length > 1 ? `${index + 1} / ${items.length}${label ? ' - ' + label : ''}` : label;
		prevBtn.hidden = items.length < 2;
		nextBtn.hidden = items.length < 2;
		prevBtn.disabled = index === 0;
		nextBtn.disabled = index === items.length - 1;
	}

	function open(trigger: HTMLImageElement) {
		lastTrigger = trigger;
		const group = trigger.closest('.strip, .gallery');
		items = group ? Array.from(group.querySelectorAll<HTMLImageElement>('img')) : [trigger];
		root.classList.add('open');
		document.documentElement.style.overflow = 'hidden';
		show(items.indexOf(trigger));
		q<HTMLButtonElement>('[data-act="close"]').focus();
	}

	function close() {
		if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
		menu.hidden = true;
		root.classList.remove('open');
		document.documentElement.style.overflow = '';
		lastTrigger?.focus();
	}

	function updateShareLinks() {
		const page = encodeURIComponent(location.href);
		const src = new URL(img.src, location.href).href;
		const text = encodeURIComponent(items[index]?.alt || document.title);
		const setLink = (name: string, href: string) => {
			(menu.querySelector(`[data-share="${name}"]`) as HTMLAnchorElement).href = href;
		};
		setLink('facebook', `https://www.facebook.com/sharer/sharer.php?u=${page}`);
		setLink('x', `https://twitter.com/intent/tweet?url=${page}&text=${text}`);
		setLink('pinterest', `https://www.pinterest.com/pin/create/button/?url=${page}&media=${encodeURIComponent(src)}&description=${text}`);
		const download = menu.querySelector('[data-share="download"]') as HTMLAnchorElement;
		download.href = src;
		download.download = src.split('/').pop() || 'image';
	}

	// ---- Buttons ----
	q('.lb-backdrop').addEventListener('click', close);
	q('[data-act="close"]').addEventListener('click', close);
	q('[data-act="zoom-in"]').addEventListener('click', () => zoomAt(0, 0, 1.4));
	q('[data-act="zoom-out"]').addEventListener('click', () => zoomAt(0, 0, 1 / 1.4));
	prevBtn.addEventListener('click', () => show(index - 1));
	nextBtn.addEventListener('click', () => show(index + 1));

	q('[data-act="share"]').addEventListener('click', () => {
		updateShareLinks();
		menu.hidden = !menu.hidden;
	});
	menu.addEventListener('click', () => {
		menu.hidden = true;
	});
	root.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('.lb-share')) menu.hidden = true;
	});

	if (!root.requestFullscreen) fsBtn.hidden = true;
	fsBtn.addEventListener('click', () => {
		if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
		else root.requestFullscreen().catch(() => {});
	});
	document.addEventListener('fullscreenchange', () => {
		fsBtn.innerHTML = document.fullscreenElement ? ICONS.exitFullscreen : ICONS.fullscreen;
		requestAnimationFrame(() => {
			fitImage();
			apply();
		});
	});

	img.addEventListener('load', () => {
		fitImage();
		apply();
	});
	window.addEventListener('resize', () => {
		if (!root.classList.contains('open')) return;
		fitImage();
		apply();
	});

	// ---- Keyboard ----
	document.addEventListener('keydown', (e) => {
		if (!root.classList.contains('open')) return;
		switch (e.key) {
			case 'Escape':
				if (!menu.hidden) menu.hidden = true;
				else close();
				break;
			case 'ArrowLeft':
				show(index - 1);
				break;
			case 'ArrowRight':
				show(index + 1);
				break;
			case '+':
			case '=':
				zoomAt(0, 0, 1.4);
				break;
			case '-':
				zoomAt(0, 0, 1 / 1.4);
				break;
			case '0':
				scale = 1;
				tx = 0;
				ty = 0;
				apply();
				break;
			default:
				return;
		}
		e.preventDefault();
	});

	// ---- Mouse wheel zoom ----
	stage.addEventListener(
		'wheel',
		(e) => {
			e.preventDefault();
			const rect = stage.getBoundingClientRect();
			const cx = e.clientX - (rect.left + rect.width / 2);
			const cy = e.clientY - (rect.top + rect.height / 2);
			zoomAt(cx, cy, Math.exp(-e.deltaY * 0.002));
		},
		{ passive: false },
	);

	// ---- Dragging: pan when zoomed in, scrub through images when not ----
	let dragging = false;
	let moved = false;
	let stepped = false;
	let startedOnImage = false;
	let startX = 0;
	let startY = 0;
	let startTx = 0;
	let startTy = 0;
	let lastX = 0;
	let stepAccum = 0;

	stage.addEventListener('pointerdown', (e) => {
		if (e.button !== 0) return;
		dragging = true;
		moved = false;
		stepped = false;
		startedOnImage = e.target === img;
		startX = e.clientX;
		startY = e.clientY;
		lastX = e.clientX;
		startTx = tx;
		startTy = ty;
		stepAccum = 0;
		stage.setPointerCapture(e.pointerId);
	});

	stage.addEventListener('pointermove', (e) => {
		if (!dragging) return;
		const dx = e.clientX - startX;
		const dy = e.clientY - startY;
		if (!moved && Math.hypot(dx, dy) > 5) moved = true;
		if (!moved) {
			lastX = e.clientX;
			return;
		}

		if (scale > 1) {
			stage.classList.add('grabbing');
			tx = startTx + dx;
			ty = startTy + dy;
			apply();
		} else if (items.length > 1) {
			stepAccum += e.clientX - lastX;
			if (stepAccum <= -STEP_PX) {
				show(index + 1);
				stepAccum = 0;
				stepped = true;
			} else if (stepAccum >= STEP_PX) {
				show(index - 1);
				stepAccum = 0;
				stepped = true;
			}
		}
		lastX = e.clientX;
	});

	const endDrag = (e: PointerEvent) => {
		if (!dragging) return;
		dragging = false;
		stage.classList.remove('grabbing');
		if (!moved) {
			if (!startedOnImage) close();
			return;
		}
		if (scale === 1 && items.length > 1 && !stepped) {
			const dx = e.clientX - startX;
			if (dx <= -40) show(index + 1);
			else if (dx >= 40) show(index - 1);
		}
	};
	stage.addEventListener('pointerup', endDrag);
	stage.addEventListener('pointercancel', () => {
		dragging = false;
		stage.classList.remove('grabbing');
	});

	// Stop the browser from "picking up" the image when you drag it
	root.addEventListener('dragstart', (e) => e.preventDefault());

	// ---- Make every case-study image open the viewer ----
	document
		.querySelectorAll<HTMLImageElement>('.case-study img, .hero-image')
		.forEach((el) => {
			if (el.closest('.compare')) return;
			el.draggable = false;
			el.tabIndex = 0;
			el.setAttribute('role', 'button');
			el.setAttribute('aria-label', `Expand image: ${el.alt}`);
			el.addEventListener('click', () => open(el));
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open(el);
				}
			});
		});
</script>
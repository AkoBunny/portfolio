---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectFeature from '../components/ProjectFeature.astro';

const allProjects = await getCollection('projects');

// Featured projects get a big panel each; everything else goes in the carousel.
// Both lists are newest first.
const featured = allProjects
	.filter((p) => p.data.featured)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const others = allProjects
	.filter((p) => !p.data.featured)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout>
	<div id="projects">
		{featured.map((project) => (
			<div class="panel reveal">
				<ProjectFeature project={project} />
			</div>
		))}

		{others.length > 0 && (
			<section class="others">
				<div class="divider" data-petals aria-hidden="true"></div>
				<div class="panel carousel reveal" data-carousel>
					<div class="carousel-head">
						<h2 class="carousel-title">Other projects</h2>
						{others.length > 1 && (
							<span class="carousel-count">1 / {others.length}</span>
						)}
					</div>

					<div class="carousel-track">
						{others.map((project) => (
							<div class="slide">
								<ProjectFeature project={project} />
							</div>
						))}
					</div>

					{others.length > 1 && (
						<div class="carousel-controls">
							<button type="button" class="carousel-btn carousel-prev" aria-label="Previous project">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
							</button>
							<div class="carousel-dots">
								{others.map((project, i) => (
									<button type="button" class="carousel-dot" aria-label={`Show project ${i + 1}: ${project.data.title}`}></button>
								))}
							</div>
							<button type="button" class="carousel-btn carousel-next" aria-label="Next project">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
							</button>
						</div>
					)}
				</div>
			</section>
		)}
	</div>
</Layout>

<style>
	/* The box around each project. --pad is the side padding, defined once and
	   reused by the carousel below so the two always match. */
	.panel {
		--pad: 2rem;
		padding: 1.5rem var(--pad) 2rem;
		border: 2px solid transparent;
		border-radius: var(--radius);
		background:
			linear-gradient(#1e2127, #1e2127) padding-box,
			#2a2d33 border-box;
		margin-bottom: 1.75rem;
	}

	/* Hovering a clickable panel turns its border into the flowing gradient.
	   These are two separate rules on purpose: if one selector in a comma-separated
	   list is invalid, the browser throws away the whole rule. */
	.panel:not(.carousel):hover {
		background:
			linear-gradient(#1e2127, #1e2127) padding-box,
			var(--gradient-flow) border-box;
		background-size: auto, 200% 100%;
		animation: flow 1.5s linear infinite;
	}

	.carousel:has(.slide:hover) {
		background:
			linear-gradient(#1e2127, #1e2127) padding-box,
			var(--gradient-flow) border-box;
		background-size: auto, 200% 100%;
		animation: flow 1.5s linear infinite;
	}

	/* Featured panels: the link stretches over the whole box, padding included */
	.panel:not(.carousel) {
		position: relative;
	}

	.panel:not(.carousel) :global(.feature) {
		position: static;
	}

	.others {
		margin-top: 0;
	}

	/* ---- Carousel ---- */

	.carousel {
		overflow: hidden;
	}

	/* Header strip: title on the left, "1 / 3" on the right, a line underneath */
	.carousel-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #2a2d33;
	}

	.carousel-title {
		margin: 0;
		font-size: 1.5rem;
		color: var(--accent-2);
	}

	.carousel-count {
		min-width: 3.5rem;
		padding: 0.2rem 0.8rem;
		text-align: center;
		border: 1px solid var(--accent);
		border-radius: 999px;
		font-family: var(--font-heading);
		font-size: 0.95rem;
		color: var(--accent);
	}

	/* The track stretches out to the edges of the box (negative margin) and puts
	   the padding back inside itself, so slides slide all the way to the edge and
	   a sliver of the next one peeks in at the side. */
	.carousel-track {
		display: flex;
		gap: var(--pad);
		margin-inline: calc(var(--pad) * -1);
		padding-inline: var(--pad);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--pad);
		scrollbar-width: none;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}

	.carousel-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.carousel-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border-radius: 50%;
		border: 1px solid var(--accent);
		background: transparent;
		color: var(--accent);
		cursor: pointer;
	}

	.carousel-btn:hover {
		background: var(--accent);
		color: #14161a;
	}

	.carousel-btn:focus-visible,
	.carousel-dot:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.carousel-dots {
		display: flex;
		gap: 0.5rem;
	}

	.carousel-dot {
		position: relative;
		width: 20px;
		height: 20px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		cursor: pointer;
	}

	.carousel-dot::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #3a3f47;
		-webkit-mask: var(--blossom-mask);
		mask: var(--blossom-mask);
	}

	.carousel-dot.active::before {
		background: var(--gradient);
	}

	@media (max-width: 600px) {
		.panel {
			--pad: 1rem;
		}
	}
</style>

<script>
	import '../scripts/carousel.ts';
</script>

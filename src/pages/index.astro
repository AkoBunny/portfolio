---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured);
---
<Layout>
	<section class="hero">
		<div class="avatar">A</div>
		<div class="hero-text">
			<h1>Ako</h1>
			<p class="role">Game Design Student — Systems &amp; Mechanics Design</p>
			<p class="intro">
				I design and build game mechanics and systems, with a focus on how
				individual pieces interact to create something that feels good to
				play. This site showcases my project work — finished, in-progress,
				and everything I'm still learning.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/portfolio/resume.pdf">Resume</a>
				<a class="btn" href="mailto:ako@pawlinska.pl">Email Me</a>
			</div>
		</div>
	</section>

	<section class="key-info">
		<div class="key-info-item">
			<span class="key-info-label">Studying at</span>
			<span class="key-info-value">ARU</span>
		</div>
		<div class="key-info-item">
			<span class="key-info-label">Focus areas</span>
			<span class="key-info-value">Systems, Mechanics, UI</span>
		</div>
		<div class="key-info-item">
			<span class="key-info-label">Tools</span>
			<span class="key-info-value">Unity, Unreal Engine</span>
		</div>
	</section>

	<section id="featured">
		<h2>Featured Projects</h2>
		<div id="featured-list">
			{featuredProjects.map((project) => (
				<a href={`/portfolio/projects/${project.id}`} class="project-card">
					<h3>{project.data.title}</h3>
					<p>{project.data.category.join(', ')}</p>
				</a>
			))}
		</div>
		<p><a href="/portfolio/projects">See all projects →</a></p>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
		margin-bottom: 2.5rem;
	}

	.avatar {
		flex: 0 0 96px;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: #ff9d5c;
		color: #14161a;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
		font-weight: 700;
	}

	.hero-text h1 {
		margin: 0 0 0.2rem;
	}

	.role {
		color: #ff9d5c;
		font-weight: 600;
		margin: 0 0 1rem;
	}

	.intro {
		max-width: 55ch;
		margin: 0 0 1.25rem;
	}

	.cta-row {
		display: flex;
		gap: 0.75rem;
	}

	.btn {
		display: inline-block;
		padding: 0.55rem 1.1rem;
		border-radius: 6px;
		border: 1px solid #ff9d5c;
		text-decoration: none;
		font-weight: 600;
	}

	.btn-primary {
		background: #ff9d5c;
		color: #14161a;
	}

	.key-info {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		border-top: 1px solid #2a2d33;
		border-bottom: 1px solid #2a2d33;
		padding: 1rem 0;
		margin-bottom: 2.5rem;
	}

	.key-info-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.key-info-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #999;
	}

	.key-info-value {
		font-weight: 600;
	}

	#featured-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 1.5rem 0;
	}

	.project-card {
		display: block;
		padding: 1rem;
		border: 1px solid #333;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
	}

	.project-card:hover {
		border-color: #8ab4ff;
	}
</style>
---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');

// Featured first, then newest first (the same rule the Projects page uses)
const projects = allProjects.sort((a, b) => {
	if (a.data.featured !== b.data.featured) {
		return a.data.featured ? -1 : 1;
	}
	return b.data.date.getTime() - a.data.date.getTime();
});

// Up to four tags per card: categories first, then the engine and tools
const tagsFor = (project: CollectionEntry<'projects'>) => {
	const tools = [project.data.engine, ...project.data.tools].filter(Boolean);
	return [
		...project.data.category.map((text) => ({ text, isTool: false })),
		...[...new Set(tools)].map((text) => ({ text, isTool: true })),
	].slice(0, 4);
};
---
<Layout>
	<section class="hero">
		<div class="avatar">A</div>
		<div class="hero-text">
			<h1>Ako</h1>
			<p class="role">Game Design Student — Systems &amp; Mechanics Design</p>
			<p class="intro">
				I design and build game mechanics and systems, with a focus on how
				individual pieces interact to create something that feels good to
				play. This site showcases my project work — finished, in-progress,
				and everything I'm still learning.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/portfolio/resume.pdf">Resume</a>
				<a class="btn" href="mailto:ako@pawlinska.pl">Email Me</a>
			</div>
		</div>
	</section>

	<section class="key-info">
		<div class="key-info-item">
			<span class="key-info-label">Studying at</span>
			<span class="key-info-value">ARU</span>
		</div>
		<div class="key-info-item">
			<span class="key-info-label">Focus areas</span>
			<span class="key-info-value">Systems, Mechanics, UI</span>
		</div>
		<div class="key-info-item">
			<span class="key-info-label">Tools</span>
			<span class="key-info-value">Unity, Unreal Engine</span>
		</div>
	</section>

	<section id="projects">
		<h2 class="section-title">Projects</h2>
		<div class="project-grid">
			{projects.map((project) => (
				<a href={`/portfolio/projects/${project.id}`} class="project-card">
					<div class="card-thumb">
						{project.data.coverImage
							? <img src={project.data.coverImage} alt="" style={`object-position: ${project.data.coverImagePosition ?? 'center'};`} />
							: <span class="thumb-placeholder">{project.data.title.charAt(0)}</span>}
						{project.data.featured && <span class="badge">Featured</span>}
					</div>
					<h3>{project.data.title}</h3>
					{project.data.hook && <p class="hook">{project.data.hook}</p>}
					<div class="tags">
						{tagsFor(project).map((tag) => (
							<span class:list={['tag', { 'tag-tool': tag.isTool }]}>{tag.text}</span>
						))}
					</div>
					<div class="card-footer">
						<span class="status">{project.data.status}</span>
						<span class="date">{project.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</span>
					</div>
				</a>
			))}
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
		margin-bottom: 2.5rem;
	}

	.avatar {
		flex: 0 0 96px;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: var(--gradient);
		color: #14161a;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
		font-weight: 700;
	}

	.hero-text h1 {
		margin: 0 0 0.2rem;
	}

	.role {
		color: var(--accent);
		font-weight: 600;
		margin: 0 0 1rem;
	}

	.intro {
		max-width: 55ch;
		margin: 0 0 1.25rem;
	}

	.cta-row {
		display: flex;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		padding: 0.6rem 1.3rem;
		border-radius: 999px;
		border: 1px solid var(--accent);
		text-decoration: none;
		font-weight: 600;
	}

	.btn:hover {
		background: var(--gradient-flow);
		background-size: 200% 100%;
		animation: flow 2s linear infinite;
		color: #14161a;
	}

	.key-info {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		border-top: 1px solid #2a2d33;
		border-bottom: 1px solid #2a2d33;
		padding: 1rem 0;
		margin-bottom: 2.5rem;
	}

	.key-info-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.key-info-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #999;
	}

	.key-info-value {
		font-weight: 600;
	}

	/* ---- Projects ---- */

	.section-title {
		margin: 0 0 1.25rem;
		font-size: 2rem;
		color: var(--accent-2);
	}

	/* As many columns as fit, each at least 300px wide, sharing leftover space equally */
	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	/* Card border: a transparent border sits over a background that is painted
	   under the border area only, so changing that background recolours the border */
	.project-card {
		display: flex;
		flex-direction: column;
		padding: 0.9rem;
		border: 2px solid transparent;
		border-radius: var(--radius);
		background:
			linear-gradient(#1e2127, #1e2127) padding-box,
			#333 border-box;
		text-decoration: none;
		color: inherit;
	}

	.project-card:hover {
		background:
			linear-gradient(#1e2127, #1e2127) padding-box,
			var(--gradient) border-box;
	}

	.project-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.3rem;
	}

	.project-card:hover h3 {
		color: var(--accent-2);
	}

	.card-thumb {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 9;
		margin-bottom: 0.9rem;
		border-radius: var(--radius-sm);
		background: #14161a;
		overflow: hidden;
	}

	.card-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb-placeholder {
		font-family: var(--font-heading);
		font-size: 3rem;
		font-weight: 600;
		color: #444;
	}

	.badge {
		position: absolute;
		top: 0.6rem;
		left: 0.6rem;
		padding: 0.2rem 0.75rem;
		border-radius: 999px;
		background: var(--gradient);
		color: #14161a;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.hook {
		margin: 0.35rem 0 0.75rem;
		color: #ccc;
		font-size: 0.95rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}

	.tag {
		font-size: 0.8rem;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: #14161a;
		border: 1px solid #444;
	}

	.tag-tool {
		border-color: var(--accent);
	}

	/* margin-top: auto pushes the footer to the bottom, so cards in a row line up */
	.card-footer {
		display: flex;
		justify-content: space-between;
		margin-top: auto;
		padding-top: 0.7rem;
		border-top: 1px solid #2a2d33;
		font-size: 0.85rem;
	}

	.status {
		color: var(--accent);
		font-weight: 600;
	}

	.date {
		color: #999;
	}
</style>

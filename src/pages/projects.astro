---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects');

const allCategories = [...new Set(projects.flatMap((p) => p.data.category))];
const allTools = [...new Set(projects.flatMap((p) => p.data.tools))];
---
<Layout>
	<h1>Projects</h1>

	<div id="controls">
		<div id="category-filters">
			<button class="filter-btn active" data-category="all">All</button>
			{allCategories.map((cat) => (
				<button class="filter-btn" data-category={cat}>{cat}</button>
			))}
		</div>

		<select id="sort-select">
			<option value="featured">Featured</option>
			<option value="date-desc">Date (Newest first)</option>
			<option value="date-asc">Date (Oldest first)</option>
		</select>
	</div>

	<div id="tool-filters">
		<button class="filter-btn tool-btn active" data-tool="all">All Tools</button>
		{allTools.map((tool) => (
			<button class="filter-btn tool-btn" data-tool={tool}>{tool}</button>
		))}
	</div>

	<div id="projects-list">
		{projects.map((project) => (
			<a
				href={`/portfolio/projects/${project.id}`}
				class="project-card"
				data-categories={project.data.category.join(',')}
				data-tools={project.data.tools.join(',')}
				data-featured={project.data.featured}
				data-date={project.data.date.toISOString()}
			>
				<h2>{project.data.title}</h2>
				<p>{project.data.category.join(', ')}</p>
				<p>{project.data.status} · {project.data.type}</p>
				<p class="date">{project.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
			</a>
		))}
	</div>
</Layout>

<style>
	#controls {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	#category-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.filter-btn {
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid #444;
		background: transparent;
		color: #f0f0f0;
		cursor: pointer;
	}

	.filter-btn.active {
		background: #8ab4ff;
		color: #14161a;
		border-color: #8ab4ff;
	}

	.tool-btn.active {
		background: #ff9d5c;
		border-color: #ff9d5c;
	}

	#tool-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	#sort-select {
		padding: 0.4rem 0.6rem;
		background: #1e2127;
		color: #f0f0f0;
		border: 1px solid #444;
		border-radius: 6px;
	}

	#projects-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.project-card {
		display: block;
		padding: 1rem;
		border: 1px solid #333;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
	}

	.project-card:hover {
		border-color: #8ab4ff;
	}

	.project-card.hidden {
		display: none;
	}

	.date {
		color: #999;
		font-size: 0.9rem;
	}
</style>

<script>
	const sortSelect = document.querySelector('#sort-select') as HTMLSelectElement;
	const list = document.querySelector('#projects-list') as HTMLElement;
	const cards = Array.from(document.querySelectorAll('.project-card')) as HTMLElement[];

let activeCategory = sessionStorage.getItem('activeCategory') ?? 'all';
	let activeTool = sessionStorage.getItem('activeTool') ?? 'all';
	const savedSort = sessionStorage.getItem('sortValue');
	if (savedSort) sortSelect.value = savedSort;

	function applyFilter() {
		for (const card of cards) {
			const cats = card.dataset.categories?.split(',') ?? [];
			const tools = card.dataset.tools?.split(',') ?? [];
			const categoryMatches = activeCategory === 'all' || cats.includes(activeCategory);
			const toolMatches = activeTool === 'all' || tools.includes(activeTool);
			card.classList.toggle('hidden', !(categoryMatches && toolMatches));
		}
	}

	function applySort() {
		const sorted = [...cards].sort((a, b) => {
			if (sortSelect.value === 'featured') {
				const aFeatured = a.dataset.featured === 'true';
				const bFeatured = b.dataset.featured === 'true';
				return Number(bFeatured) - Number(aFeatured);
			}
			const aDate = new Date(a.dataset.date ?? '').getTime();
			const bDate = new Date(b.dataset.date ?? '').getTime();
			return sortSelect.value === 'date-desc' ? bDate - aDate : aDate - bDate;
		});
		for (const card of sorted) {
			list.appendChild(card);
		}
	}

const categoryButtons = document.querySelectorAll('.filter-btn:not(.tool-btn)');
	const toolButtons = document.querySelectorAll('.tool-btn');

categoryButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			categoryButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			activeCategory = (btn as HTMLElement).dataset.category ?? 'all';
			sessionStorage.setItem('activeCategory', activeCategory);
			applyFilter();
		});
	});

toolButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			toolButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			activeTool = (btn as HTMLElement).dataset.tool ?? 'all';
			sessionStorage.setItem('activeTool', activeTool);
			applyFilter();
		});
	});

sortSelect.addEventListener('change', () => {
		sessionStorage.setItem('sortValue', sortSelect.value);
		applySort();
	});

categoryButtons.forEach((btn) => {
		if ((btn as HTMLElement).dataset.category === activeCategory) {
			categoryButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
		}
	});
	toolButtons.forEach((btn) => {
		if ((btn as HTMLElement).dataset.tool === activeTool) {
			toolButtons.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
		}
	});
	applyFilter();
	applySort();
</script>
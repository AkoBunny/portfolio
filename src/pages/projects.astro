---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects');

const sortedProjects = projects.sort((a, b) => {
	if (a.data.featured !== b.data.featured) {
		return a.data.featured ? -1 : 1;
	}
	return b.data.date.getTime() - a.data.date.getTime();
});
---
<Layout>
	<h1>Projects</h1>

	<div id="projects-list">
		{sortedProjects.map((project) => (
			<a href={`/portfolio/projects/${project.id}`} class="project-card">
				<div class="card-thumb">
					{project.data.coverImage
						? <img src={project.data.coverImage} alt="" style={`object-position: ${project.data.coverImagePosition ?? 'center'};`} />
						: <span class="thumb-placeholder">{project.data.title.charAt(0)}</span>}
				</div>
				<h2>{project.data.title}</h2>
				{project.data.hook && <p class="hook">{project.data.hook}</p>}
				<div class="tags">
					{project.data.category.map((cat) => <span class="tag">{cat}</span>)}
					{project.data.tools.map((tool) => <span class="tag tag-tool">{tool}</span>)}
				</div>
				<p>{project.data.status}</p>
				<p class="date">{project.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
			</a>
		))}
	</div>
</Layout>

<style>
	#projects-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.project-card {
		display: block;
		padding: 1rem;
		border: 1px solid #333;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
	}

	.project-card:hover {
		border-color: #8ab4ff;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.5rem 0;
	}

	.tag {
		font-size: 0.8rem;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: #1e2127;
		border: 1px solid #444;
	}

	.tag-tool {
		border-color: #ff9d5c;
	}

	.date {
		color: #999;
		font-size: 0.9rem;
	}

		.card-thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		background: #1e2127;
		border: 1px solid #333;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.75rem;
		overflow: hidden;
	}

		.card-thumb {
		background: #14161a;
	}

	.card-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb-placeholder {
		font-size: 2.5rem;
		font-weight: 700;
		color: #444;
	}

	.hook {
		color: #ccc;
		margin: 0 0 0.5rem;
	}
</style>